generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  MANAGER
  VENDOR
}

model User {
  id        String   @id @default(cuid())

  name      String
  email     String   @unique
  password  String

  role      Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}